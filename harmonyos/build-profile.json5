{
  // 工程级构建配置。runtimeOS 固定为 HarmonyOS（纯血 NEXT）。
  // compatibleSdkVersion 括号内为 API Level：(12)=API12，(13)=API13。
  // 若本机 DevEco SDK 版本不同，首次打开工程时按提示同步即可。
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "versionCode": 1000000,
        "versionName": "1.0.0",
        "compatibleSdkVersion": "5.0.1(13)",
        "targetSdkVersion": "5.0.1(13)",
        "compileSdkVersion": "5.0.1(13)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
