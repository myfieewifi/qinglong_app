/** 青龙 Logo：圆角方块 + 白字（或反色）。 */
@Component
export struct LogoMark {
  @State size: number = 48;
  @State markRadius: number = 11;
  @State bg: ResourceColor = $r('app.color.brand_color');
  @State fg: ResourceColor = Color.White;

  build() {
    Column() {
      Text('青龙')
        .fontSize(this.size * 0.4)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.fg)
        .maxLines(1);
    }
    .width(this.size).height(this.size)
    .justifyContent(FlexAlign.Center)
    .backgroundColor(this.bg)
    .borderRadius(this.markRadius);
  }
}

/** 线性图标：按名字取 Path 绘制，等比缩放到 size。 */
@Component
export struct AppIcon {
  @State name: string = 'info';
  @State size: number = 22;
  @State iconColor: ResourceColor = $r('app.color.brand_color');
  onTap?: () => void;

  private currentPaths(): string[] {
    const arr: string[] | undefined = ICON_PATHS[this.name];
    if (arr === undefined) {
      return [];
    }
    return arr;
  }

  build() {
    Stack() {
      ForEach(this.currentPaths(), (d: string) => {
        Path().commands(d)
          .width(24).height(24)
          .fillOpacity(0)
          .stroke(this.iconColor)
          .strokeWidth(1.7)
          .strokeLineCap(LineCapStyle.Round)
          .strokeLineJoin(LineJoinStyle.Round)
          .strokeMiterLimit(4)
          .scale({
            x: this.size / 24,
            y: this.size / 24,
            centerX: 12,
            centerY: 12
          });
      }, (d: string) => d);
    }
    .width(this.size).height(this.size)
    .onClick(() => { if (this.onTap) { this.onTap(); } });
  }
}
